{
  "name": "go-wind-admin",
  "version": "5.4.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:cspell": "cspell lint **/*.ts **/README.md .changeset/*.md --no-progress",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "prepare": "node scripts/rebuild-framework-links.mjs && (is-ci || husky)",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/prettier-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "husky": "catalog:",
    "is-ci": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.22",
    "vue-tsc": "catalog:",
    "@tanstack/vue-query-devtools": "^6.1.33",
    "@types/crypto-js": "^4.2.2"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@11.18.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "overrides": {
      "@ast-grep/napi": "catalog:",
      "@ctrl/tinycolor": "catalog:",
      "clsx": "catalog:",
      "pinia": "catalog:",
      "vue": "catalog:"
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --write --parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,less,styl,html}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@iconify/json": "catalog:",
    "@iconify/vue": "catalog:",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/vue-query": "catalog:",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-heading": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-horizontal-rule": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-subscript": "^3.20.0",
    "@tiptap/extension-superscript": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/vue-3": "^3.20.0",
    "@vueuse/core": "catalog:",
    "ant-design-vue": "catalog:",
    "axios": "catalog:",
    "cropperjs": "^2.1.0",
    "crypto-js": "^4.2.0",
    "dayjs": "catalog:",
    "defu": "catalog:",
    "dompurify": "3.2.7",
    "exceljs": "catalog:",
    "highlight.js": "^11.11.1",
    "json-editor-vue": "^0.18.1",
    "jsoneditor": "^10.4.2",
    "lowlight": "^3.3.0",
    "marked": "^17.0.3",
    "md-editor-v3": "^6.3.1",
    "monaco-editor": "^0.55.1",
    "pinia": "2.2.2",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "@ctrl/tinycolor": "catalog:",
    "@tanstack/vue-store": "catalog:",
    "@vue/shared": "catalog:",
    "clsx": "catalog:",
    "lodash.clonedeep": "catalog:",
    "lodash.get": "catalog:",
    "lodash.isequal": "catalog:",
    "nprogress": "catalog:",
    "tailwind-merge": "catalog:",
    "theme-colors": "catalog:",
    "@types/lodash.clonedeep": "catalog:",
    "@types/lodash.get": "catalog:",
    "@types/lodash.isequal": "catalog:",
    "@types/nprogress": "catalog:",
    "lucide-vue-next": "catalog:",
    "radix-vue": "catalog:",
    "sortablejs": "catalog:",
    "@types/sortablejs": "catalog:",
    "class-variance-authority": "catalog:",
    "vee-validate": "catalog:",
    "@vee-validate/zod": "catalog:",
    "zod": "catalog:",
    "zod-defaults": "catalog:",
    "@vueuse/integrations": "catalog:",
    "vue-json-viewer": "catalog:",
    "json-bigint": "catalog:",
    "qrcode": "catalog:",
    "@types/qrcode": "catalog:",
    "watermark-js-plus": "catalog:",
    "echarts": "catalog:",
    "vxe-pc-ui": "catalog:",
    "vxe-table": "catalog:",
    "axios-mock-adapter": "catalog:",
    "@intlify/core-base": "catalog:",
    "vue-i18n": "catalog:",
    "pinia-plugin-persistedstate": "catalog:"
  },
  "imports": {
    "#/*": [
      "./src/*"
    ],
    "$/*": [
      "./generated/*"
    ]
  }
}
