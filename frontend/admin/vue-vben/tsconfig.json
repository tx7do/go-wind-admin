{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./build-config/tsconfig/web-app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": [
        "./src/*"
      ],
      "$/*": [
        "./generated/*"
      ],
      "@vben-core/shared": [
        "node_modules/@go-wind/admin-vben/src/base/shared/constants/index.ts"
      ],
      "@vben-core/shared/*": [
        "node_modules/@go-wind/admin-vben/src/base/shared/*"
      ],
      "@vben-core/typings": [
        "node_modules/@go-wind/admin-vben/src/base/typings/index.ts"
      ],
      "@vben-core/typings/*": [
        "node_modules/@go-wind/admin-vben/src/base/typings/*"
      ],
      "@vben-core/icons": [
        "node_modules/@go-wind/admin-vben/src/base/icons/index.ts"
      ],
      "@vben-core/icons/*": [
        "node_modules/@go-wind/admin-vben/src/base/icons/*"
      ],
      "@vben-core/design": [
        "node_modules/@go-wind/admin-vben/src/base/design/index.ts"
      ],
      "@vben-core/design/*": [
        "node_modules/@go-wind/admin-vben/src/base/design/*"
      ],
      "@vben-core/composables": [
        "node_modules/@go-wind/admin-vben/src/core/composables/index.ts"
      ],
      "@vben-core/composables/*": [
        "node_modules/@go-wind/admin-vben/src/core/composables/*"
      ],
      "@vben-core/preferences": [
        "node_modules/@go-wind/admin-vben/src/core/preferences/index.ts"
      ],
      "@vben-core/preferences/*": [
        "node_modules/@go-wind/admin-vben/src/core/preferences/*"
      ],
      "@vben-core/shadcn-ui": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/shadcn-ui/index.ts"
      ],
      "@vben-core/shadcn-ui/*": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/shadcn-ui/*"
      ],
      "@vben-core/form-ui": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/form-ui/index.ts"
      ],
      "@vben-core/form-ui/*": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/form-ui/*"
      ],
      "@vben-core/popup-ui": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/popup-ui/index.ts"
      ],
      "@vben-core/popup-ui/*": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/popup-ui/*"
      ],
      "@vben-core/menu-ui": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/menu-ui/index.ts"
      ],
      "@vben-core/menu-ui/*": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/menu-ui/*"
      ],
      "@vben-core/layout-ui": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/layout-ui/index.ts"
      ],
      "@vben-core/layout-ui/*": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/layout-ui/*"
      ],
      "@vben-core/tabs-ui": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/tabs-ui/index.ts"
      ],
      "@vben-core/tabs-ui/*": [
        "node_modules/@go-wind/admin-vben/src/ui-kit/tabs-ui/*"
      ],
      "@vben/access": [
        "node_modules/@go-wind/admin-vben/src/effects/access/index.ts"
      ],
      "@vben/access/*": [
        "node_modules/@go-wind/admin-vben/src/effects/access/*"
      ],
      "@vben/common-ui": [
        "node_modules/@go-wind/admin-vben/src/effects/common-ui/index.ts"
      ],
      "@vben/common-ui/*": [
        "node_modules/@go-wind/admin-vben/src/effects/common-ui/*"
      ],
      "@vben/hooks": [
        "node_modules/@go-wind/admin-vben/src/effects/hooks/index.ts"
      ],
      "@vben/hooks/*": [
        "node_modules/@go-wind/admin-vben/src/effects/hooks/*"
      ],
      "@vben/layouts": [
        "framework/effects/layouts/index.ts"
      ],
      "@vben/layouts/*": [
        "framework/effects/layouts/*"
      ],
      "@vben/plugins": [
        "framework/effects/plugins/index.ts"
      ],
      "@vben/plugins/*": [
        "framework/effects/plugins/*"
      ],
      "@vben/constants": [
        "node_modules/@go-wind/admin-vben/src/constants/index.ts"
      ],
      "@vben/constants/*": [
        "node_modules/@go-wind/admin-vben/src/constants/*"
      ],
      "@vben/icons": [
        "node_modules/@go-wind/admin-vben/src/icons/index.ts"
      ],
      "@vben/icons/*": [
        "node_modules/@go-wind/admin-vben/src/icons/*"
      ],
      "@vben/locales": [
        "node_modules/@go-wind/admin-vben/src/locales/index.ts"
      ],
      "@vben/locales/*": [
        "node_modules/@go-wind/admin-vben/src/locales/*"
      ],
      "@vben/preferences": [
        "node_modules/@go-wind/admin-vben/src/preferences/index.ts"
      ],
      "@vben/preferences/*": [
        "node_modules/@go-wind/admin-vben/src/preferences/*"
      ],
      "@vben/stores": [
        "node_modules/@go-wind/admin-vben/src/stores/index.ts"
      ],
      "@vben/stores/*": [
        "node_modules/@go-wind/admin-vben/src/stores/*"
      ],
      "@vben/styles": [
        "node_modules/@go-wind/admin-vben/src/styles/index.ts"
      ],
      "@vben/styles/*": [
        "node_modules/@go-wind/admin-vben/src/styles/*"
      ],
      "@vben/types": [
        "node_modules/@go-wind/admin-vben/src/types/index.ts"
      ],
      "@vben/types/*": [
        "node_modules/@go-wind/admin-vben/src/types/*"
      ],
      "@vben/utils": [
        "node_modules/@go-wind/admin-vben/src/utils/index.ts"
      ],
      "@vben/utils/*": [
        "node_modules/@go-wind/admin-vben/src/utils/*"
      ]
    }
  },
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "include": [
    "node_modules/@go-wind/admin-vben/src/types/global.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "generated/**/*.ts",
    "framework/**/*.ts",
    "framework/**/*.tsx",
    "framework/**/*.vue"
  ],
  "exclude": [
    "framework/**/__tests__/**"
  ]
}
