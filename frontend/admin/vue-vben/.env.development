# 端口号
VITE_PORT=15666

VITE_BASE=/

# 接口地址（dev 走 vite 代理同源转发，见 vite.config.mts 的 /admin 代理；勿写完整后端 URL，浏览器直连会吃 CORS）
#VITE_GLOB_API_URL=https://apifoxmock.com/m1/5619700-5299226-default/admin/v1
VITE_GLOB_API_URL=/
#VITE_GLOB_API_URL=https://api.demo.admin.gowind.cloud

# SSE地址
VITE_GLOB_SSE_URL=http://localhost:7789/events
#VITE_GLOB_SSE_URL=https://sse.demo.admin.gowind.cloud/events

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 路由的访问模式：frontend，backend
VITE_ROUTER_ACCESS_MODE=frontend

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# TanStack Query devtools 悬浮球会遮挡右下角弹层按钮（自动化走查时关掉）
VITE_QUERY_DEVTOOLS=false
