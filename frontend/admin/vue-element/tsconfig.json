{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // vue 系类型统一指到宿主物理实例：@go-wind/admin-element 以 link/dist 形态消费时，
      // 其 d.ts 里的 vue/vue-router/@tanstack 类型引用若按包所在树解析会形成同名类型
      // 双实例（RouterClassic/RouteRecordRaw 私有字段互斥）。paths 对传递 d.ts 全局生效，
      // 强制全部落回宿主唯一副本。
      "vue": ["node_modules/vue"],
      "vue-router": ["node_modules/vue-router"],
      "pinia": ["node_modules/pinia"],
      "@tanstack/vue-query": ["node_modules/@tanstack/vue-query"],
      "vue-i18n": ["node_modules/vue-i18n"]
    },

    // 严格性和类型检查相关配置
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 模块和兼容性相关配置
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // 调试和兼容性相关配置
    "sourceMap": true,
    "useDefineForClassFields": true,
    "allowJs": true,

    // 类型声明相关配置
    "types": ["node", "vite/client", "element-plus/global"]
  },

  "include": [
    "types/**/*.d.ts",
    "mock/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "eslint.config.ts",
    "uno.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
