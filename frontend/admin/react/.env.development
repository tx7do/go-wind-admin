# 环境变量配置文件
VITE_ENV=dev

# 端口号
VITE_SERVER_PORT=15888

# 跨域：/admin 前缀请求由 vite dev server 代理转发到后端，避免直连触发 CORS。
# 注意：后端路由本身就带 /admin/v1 前缀，故代理不做 rewrite，原样转发。
VITE_PROXY='[["/admin", "http://127.0.0.1:7788/"]]'

# API 基础地址：设为根路径 "/"。
# connectrpc 生成的 client path 形如 "admin/v1/captcha"（无前导 /），
# 若 baseURL 为空，axios 会原样返回该 path，被浏览器当作相对当前页面
# 目录解析（如 /auth/login 页面下变成 /auth/admin/v1/captcha），
# 导致路径错位。设 baseURL="/" 使 combineURLs 拼出 "/admin/v1/captcha"
# 绝对路径，由上方 VITE_PROXY 转发到后端，避免 CORS 与路径错位。
VITE_API_URL=/

# SSE地址
VITE_SSE_URL=http://localhost:7789/events

# TanStack Query devtools 悬浮球会遮挡右下角弹层按钮（自动化走查时关掉）
VITE_QUERY_DEVTOOLS=false
